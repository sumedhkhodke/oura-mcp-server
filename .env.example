# ---------------------------------------------------------------------------
# Option A — OAuth2 (recommended; required for new integrations)
# ---------------------------------------------------------------------------
# Register an app at https://cloud.ouraring.com/oauth/applications with redirect
# URI http://localhost:8080/callback, then run `oura-mcp-server login`.
# The login command reads these two values (or accepts --client-id/--client-secret):
OURA_CLIENT_ID=your_oauth_client_id
OURA_CLIENT_SECRET=your_oauth_client_secret
# Optional: loopback port for the login redirect (must match the registered URI).
# OURA_REDIRECT_PORT=8080
# Optional: where the OAuth token file is written (default ~/.oura-mcp/tokens.json).
# OURA_TOKEN_FILE=~/.oura-mcp/tokens.json

# ---------------------------------------------------------------------------
# Option B — Static bearer token (legacy PAT, or any access token you paste)
# ---------------------------------------------------------------------------
# If set, this takes precedence over the OAuth token file. Cannot self-refresh.
# Legacy Personal Access Tokens (pre-Dec-2025) still work here:
# https://cloud.ouraring.com/personal-access-tokens
# OURA_ACCESS_TOKEN=your_token_here

# Optional: override the API base URL (e.g. to point at a sandbox).
# OURA_API_BASE_URL=https://api.ouraring.com/v2

# ---------------------------------------------------------------------------
# Client-facing OAuth (remote/hosted deployments, e.g. Railway)
# ---------------------------------------------------------------------------
# Create a GitHub OAuth App whose callback URL is:
#   https://your-server.example/auth/callback
# Only allowlisted GitHub users can authorize access to this personal Oura account.
# OURA_MCP_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
# OURA_MCP_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# OURA_MCP_ALLOWED_GITHUB_USERS=your-github-login
# Required outside Railway. Railway derives this from RAILWAY_PUBLIC_DOMAIN.
# OURA_MCP_BASE_URL=https://your-server.example
# Generate once and keep stable across deploys:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# OURA_MCP_JWT_SIGNING_KEY=your_stable_random_signing_key
# Persist FastMCP's encrypted OAuth client/token state on a mounted volume.
# FASTMCP_HOME=/data/fastmcp
# Oura refresh tokens are single-use: persist the rotated token file on the
# volume as well, or a container restart falls back to the consumed env seed.
# OURA_TOKEN_FILE=/data/oura/tokens.json
