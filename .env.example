# Oura API access token used by the MCP server as a Bearer credential.
#
# This can be EITHER:
#   1. A legacy Personal Access Token (PAT) — only if you created one before
#      Oura deprecated new PATs in December 2025. Existing PATs still work.
#      Manage existing tokens: https://cloud.ouraring.com/personal-access-tokens
#   2. An OAuth2 access token obtained via the authorization code flow.
#      Register an app at https://cloud.ouraring.com/oauth/applications
#
# The server treats it as an opaque bearer token either way.
OURA_ACCESS_TOKEN=your_token_here

# Optional: override the API base URL (e.g. to point at a sandbox).
# OURA_API_BASE_URL=https://api.ouraring.com/v2
